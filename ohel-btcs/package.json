{
  "name": "ohel-btcs",
  "version": "0.1.0",
  "private": true,
  "description": "Publicité vidéo BTCS — OHEL International (Remotion)",
  "scripts": {
    "scan": "tsx scripts/scan-assets.ts",
    "storyboard": "tsx scripts/storyboard.ts",
    "check": "tsc --noEmit && tsx scripts/check.ts",
    "studio": "npm run scan && remotion studio",
    "stills": "npm run scan && tsx scripts/stills.ts",
    "render:draft": "npm run scan && tsx scripts/render.ts --draft",
    "render:all": "npm run scan && npm run check && tsx scripts/render.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
