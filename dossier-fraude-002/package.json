{
  "name": "dossier-fraude-002",
  "version": "1.0.0",
  "private": true,
  "description": "Dossier Fraude N°002 — Le faux agent MTN Mobile Money (motion design de sensibilisation, Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "sfx": "node scripts/generate-sfx.mjs",
