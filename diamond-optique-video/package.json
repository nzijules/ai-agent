{
  "name": "diamond-optique-video",
  "version": "1.0.0",
  "description": "Publicité Vibe Motion Design 35s — Diamond Optique recrutement",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc",
    "render": "remotion render src/index.ts DiamondOptique out/diamond-optique-recrutement-1080x1920.mp4 --audio-codec=aac",
    "render:subs": "remotion render src/index.ts DiamondOptiqueSousTitres out/diamond-optique-sous-titres.mp4 --audio-codec=aac",
    "render:all": "npm run render && npm run render:subs",
    "still": "remotion still src/index.ts DiamondOptique"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "^4.0.541",
    "@remotion/fonts": "^4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}