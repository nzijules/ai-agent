{
  "name": "arosoft-forensics-video",
  "version": "1.0.0",
  "description": "AroSoft — « Effacé du téléphone. Vraiment disparu ? » : vidéo de sensibilisation Mobile Digital Forensics (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "^4.0.541",
    "@remotion/media": "^4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render AroSoftForensics out/arosoft-forensics.mp4 --codec=h264 --crf=18 --audio-codec=aac --separate-audio-to=out/arosoft-forensics-audio.m4a",
    "render:draft": "remotion render AroSoftForensics out/arosoft-forensics-draft.mp4 --codec=h264 --scale=0.5 --crf=26",
    "render:audio": "remotion render AroSoftForensics out/arosoft-forensics-audio.wav --codec=wav",
    "still": "remotion still AroSoftForensics out/poster.png --frame=2880",
    "logo": "python3 scripts/make-dark-logo.py public/brand/arosoft-logo.jpg public/brand/arosoft-logo-dark.png"
  },
  "allowScripts": {
    "esbuild": false
  }
}
