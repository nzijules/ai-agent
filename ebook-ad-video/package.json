{
  "name": "pub-apprendre-a-apprendre-avec-chatgpt",
  "version": "1.0.0",
  "description": "Publicité motion design — ebook « Apprendre à apprendre avec ChatGPT »",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "^4.0.540",
    "@remotion/google-fonts": "^4.0.540",
    "@remotion/media": "^4.0.540",
    "@remotion/transitions": "^4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "audio": "python3 scripts/generate_audio.py",
    "voiceover": "python3 scripts/generate_voiceover.py",
    "render:vertical": "remotion render Pub-Verticale-VoixOff exports/pub-controle-verticale-1080x1920-voix-off.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:vertical-sans-voix": "remotion render Pub-Verticale-SansVoix exports/pub-controle-verticale-1080x1920-sans-voix.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:carre": "remotion render Pub-Carree-VoixOff exports/pub-controle-carree-1080x1080-voix-off.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:carre-sans-voix": "remotion render Pub-Carree-SansVoix exports/pub-controle-carree-1080x1080-sans-voix.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:all": "npm run render:vertical && npm run render:vertical-sans-voix && npm run render:carre && npm run render:carre-sans-voix && bash scripts/normalize_audio.sh",
    "render:eco-vertical": "remotion render Pub-Verticale-Economie-VoixOff exports/pub-economie-verticale-1080x1920-voix-off.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:eco-vertical-sans-voix": "remotion render Pub-Verticale-Economie-SansVoix exports/pub-economie-verticale-1080x1920-sans-voix.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:eco-carre": "remotion render Pub-Carree-Economie-VoixOff exports/pub-economie-carree-1080x1080-voix-off.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:eco-carre-sans-voix": "remotion render Pub-Carree-Economie-SansVoix exports/pub-economie-carree-1080x1080-sans-voix.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:eco-all": "npm run render:eco-vertical && npm run render:eco-vertical-sans-voix && npm run render:eco-carre && npm run render:eco-carre-sans-voix && bash scripts/normalize_audio.sh",
    "render:court-controle": "remotion render Pub-Verticale-Controle-Court-VoixOff exports/tiktok-controle-30s-1080x1920.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:court-economie": "remotion render Pub-Verticale-Economie-Court-VoixOff exports/tiktok-economie-30s-1080x1920.mp4 --codec=h264 --crf=20 --audio-codec=aac",
    "render:courts": "npm run render:court-controle && npm run render:court-economie"
  },
  "allowScripts": {
    "esbuild": false
  }
}
